generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Patient {
  id        Int      @id @default(autoincrement())
  name      String?
  createdAt DateTime @default(now())
  notes     Note[]
}

model Note {
  id               Int      @id @default(autoincrement())
  patientId        Int?     // Made optional for now so API can save without selecting patient
  patient          Patient? @relation(fields: [patientId], references: [id])
  /// @encrypted
  transcript       String   @db.Text
  /// @encrypted
  subjective       String?  @db.Text
  /// @encrypted
  objective        String?  @db.Text
  /// @encrypted
  assessment       String?  @db.Text
  /// @encrypted
  lifestyle_advice String?  @db.Text
  /// @encrypted
  medications      String?  @db.Text
  /// @encrypted
  billing_codes    String?  @db.Text
  createdAt        DateTime @default(now())
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   Int?
  details    String?  @db.Text
  createdAt  DateTime @default(now())
}
