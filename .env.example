# AWS Credentials (REQUIRED)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_company_aws_access_key
AWS_SECRET_ACCESS_KEY=your_company_aws_secret_key

# Specific AWS Overrides (Optional)
STT_AWS_REGION=us-east-1
STT_AWS_ACCESS_KEY_ID=your_company_aws_access_key
STT_AWS_SECRET_ACCESS_KEY=your_company_aws_secret_key

NLP_AWS_REGION=us-east-1
NLP_AWS_ACCESS_KEY_ID=your_company_aws_access_key
NLP_AWS_SECRET_ACCESS_KEY=your_company_aws_secret_key

LLM_AWS_REGION=us-east-1
LLM_AWS_ACCESS_KEY_ID=your_company_aws_access_key
LLM_AWS_SECRET_ACCESS_KEY=your_company_aws_secret_key

# Groq LLM API Key (REQUIRED)
GROQ_API_KEY=gsk_your_company_groq_api_key

# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/myhealthjourney?schema=public"

# Other Third-Party APIs
OPENAI_API_KEY=sk-your_company_openai_key
