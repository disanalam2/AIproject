generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Appointment {
  id              Int      @id @default(autoincrement())
  patientName     String /// @encrypted
  patientPhone    String /// @encrypted
  appointmentDate DateTime
  reason          String? /// @encrypted
  status          String   @default("CONFIRMED") // CONFIRMED, CANCELED, RESCHEDULED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CallLog {
  id                Int      @id @default(autoincrement())
  phoneNumber       String /// @encrypted
  transcript        String   @db.Text
  extractedSymptoms String?  @db.Text
  intent            String
  duration          Int? // in seconds
  createdAt         DateTime @default(now())
}

model Configuration {
  key   String @id
  value String
}

model Secret {
  key   String @id
  value String @db.Text /// @encrypted
}
